---
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'portfolio' | 'game';
  bodyClass?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description,
  active,
  bodyClass = 'bg-gray-100 text-gray-800',
  ogType = 'website',
  ogTitle,
  ogDescription,
} = Astro.props;

const HUBS = ['home', 'portfolio', 'game'];
if (!HUBS.includes(active)) {
  throw new Error(
    `BaseLayout.astro: invalid active ${JSON.stringify(active)}. ` +
    `Expected one of ${HUBS.join(', ')}. ` +
    `This sets <body data-hub>, which hub-nav.js uses for active-link highlighting and aria-current.`
  );
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo title={title} description={description} ogType={ogType} ogTitle={ogTitle} ogDescription={ogDescription} />
    <link rel="stylesheet" href="/assets/css/tailwind.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css" />
    <slot name="head" />
  </head>
  <body class={bodyClass} data-hub={active} data-site-theme="warm-dark">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div id="vanta-bg" class="fixed inset-0 -z-10" aria-hidden="true"></div>
    <slot />
    <script src="/assets/js/hub-nav.js" defer></script>
    <slot name="scripts" />
  </body>
</html>
