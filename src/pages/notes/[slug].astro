---
import NoteLayout from '../../layouts/NoteLayout.astro';
import NoteParagraph from '../../components/NoteParagraph.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.mdx?$/, '') },
    props: { note }
  }));
}

// Eyebrow text differs per note and is not part of the MDX frontmatter —
// it comes from each static page's own eyebrow (notes/<slug>.html).
const EYEBROWS: Record<string, string> = {
  'repair-debugging': 'Repair to software',
  'ocr-human-review': 'AI/Data',
  'biomes-data-assets': 'Game lab',
};

// Static <title> uses Title Case, distinct from the sentence-case <h1>
// (and MDX frontmatter title) — read verbatim from notes/<slug>.html.
const PAGE_TITLES: Record<string, string> = {
  'repair-debugging': 'What Appliance Repair Taught Me About Debugging Software | Timothy Creekmore',
  'ocr-human-review': 'Why OCR Projects Need Human Review From Day One | Timothy Creekmore',
  'biomes-data-assets': 'Designing Biomes as Data Assets in Unity | Timothy Creekmore',
};

const { note } = Astro.props;
const slug = note.id.replace(/\.mdx?$/, '');
const { Content } = await render(note);
---
<NoteLayout title={note.data.title} pageTitle={PAGE_TITLES[slug]} description={note.data.summary} eyebrow={EYEBROWS[slug]} pubDate={note.data.pubDate}>
  <Content components={{ p: NoteParagraph }} />
</NoteLayout>
