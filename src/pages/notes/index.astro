---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { sortNotes, formatNoteDate } from '../../lib/notes';

// Rendered from the collection, not hardcoded. The previous hardcoded markup
// had already drifted once -- it kept citing a project that had been deleted --
// and a second copy of every title and summary is a second thing to forget to
// update. The sort itself lives in src/lib/notes.ts so this page and the home
// page cannot disagree about order.
const notes = sortNotes(await getCollection('notes'));
---
<BaseLayout
  title="Field Notes | Timothy Creekmore"
  description="Field notes from Timothy Creekmore on software, AI/data, game systems, and repair-to-software thinking."
  bodyClass="bg-gray-100 text-gray-800"
>
  <div class="grid-field" aria-hidden="true"></div>
  <Nav active="notes" />
  <main id="main-content" class="pt-12 pb-16">
    <div class="max-w-3xl mx-auto px-6">
      <section>
        <p class="eyebrow mb-4">Field Notes</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Short practical notes</h1>
        <p class="text-lg text-gray-600 max-w-3xl leading-relaxed mb-10">Not a formal blog. More like a workbench log: lessons from software, data projects, AI workflows, game systems, and repair work.</p>
        <div class="grid md:grid-cols-3 gap-5">
          {notes.map((n) => (
            <a href={`/notes/${n.id.replace(/\.mdx?$/, '')}/`} class="card p-5 block hover:border-[#23405e] transition">
              <p class="eyebrow mb-2">{n.data.category}</p>
              <h2 class="text-xl font-semibold text-gray-900 mb-2">{n.data.title}</h2>
              <p class="text-sm text-gray-700">{n.data.summary}</p>
              <p class="tick mt-3">{formatNoteDate(n.data.pubDate)}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
